# ─── Base ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Base de données (PostgreSQL Scalingo) ────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/masterclass_medical

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your-secret-here  # Générer avec : openssl rand -base64 32

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Abonnement formateur (créer le price dans le dashboard Stripe)
STRIPE_SUBSCRIPTION_PRICE_ID=price_...

# ─── Brevo (emails transactionnels) ──────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_NAME=Masterclass Médical
BREVO_SENDER_EMAIL=noreply@masterclassmedical.fr
