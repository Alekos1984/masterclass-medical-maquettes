generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  PARTICIPANT
  FORMATEUR
  ADMIN
}

enum StatutFormation {
  BROUILLON
  EN_ATTENTE_SALLE
  SALLE_CONFIRMEE
  PUBLIEE
  COMPLETE
  ANNULEE
}

enum StatutInscription {
  EN_ATTENTE_PAIEMENT
  CONFIRMEE
  ANNULEE
  REMBOURSEE
}

enum StatutPaiement {
  EN_ATTENTE
  CAPTE
  REMBOURSE
  ECHOUE
}

enum TypePaiement {
  INSCRIPTION
  FRAIS_SALLE
  ABONNEMENT
}

enum StatutDemandeSalle {
  EN_ATTENTE
  CONTACT_HOTEL
  DEVIS_RECU
  VALIDE
  TRANSMIS_FORMATEUR
  PAYE
}

enum StatutVirement {
  EN_ATTENTE
  EFFECTUE
}

enum StatutRemboursement {
  EN_ATTENTE
  APPROUVE
  REFUSE
  EFFECTUE
}

enum StatutAbonnement {
  INACTIF
  ACTIF
  SUSPENDU
  RESILIE
}

// ─── NEXTAUTH ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String?
  image         String?
  role          Role      @default(PARTICIPANT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  formateurProfile   FormateurProfile?
  participantProfile ParticipantProfile?
}

model FormateurProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identité professionnelle
  titre      String?
  specialite String?
  rpps       String? @unique
  phone      String?
  adresse    String?
  ville      String?
  codePostal String?

  // CV scientifique
  bio             String? @db.Text
  experienceAns   Int?
  publications    Int?    @default(0)
  linkedinUrl     String?
  researchgateUrl String?
  pubmedUrl       String?

  // Infos légales
  siret         String?
  raisonSociale String?
  iban          String?
  bic           String?

  // Signature formateur
  signatureBase64  String?  @db.Text

  // Stripe
  stripeCustomerId String? @unique
  stripeAccountId  String? @unique // Stripe Connect Express

  // Abonnement (actif à partir de la 4e formation)
  statutAbonnement     StatutAbonnement @default(INACTIF)
  stripeSubscriptionId String?          @unique
  abonnementDebut      DateTime?
  abonnementFin        DateTime?

  // Compteur formations (3 premières gratuites)
  formationsTotal Int     @default(0)
  portfolioPublic Boolean @default(true)

  formations       Formation[]
  virements        Virement[]
  publicationsList Publication[]
  cursusCoordonnes Cursus[]    @relation("CursusCoordonnes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Publication {
  id          String           @id @default(cuid())
  formateurId String
  formateur   FormateurProfile @relation(fields: [formateurId], references: [id], onDelete: Cascade)

  pmid      String?
  titre     String  @db.Text
  auteurs   String  @db.Text
  revue     String?
  annee     Int?
  doi       String?
  url       String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([formateurId, pmid])
}

model ParticipantProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titre      String?
  specialite String?
  rpps       String?
  phone      String?

  // Facturation
  adresse    String?
  ville      String?
  codePostal String?
  pays       String? @default("France")

  // Stripe
  stripeCustomerId String? @unique

  // Préférences notifications
  notifEmail   Boolean @default(true)
  notifRappels Boolean @default(true)

  // Signature participant
  signatureBase64 String? @db.Text

  inscriptions Inscription[]
  questions    Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── CLASSE VIRTUELLE ─────────────────────────────────────────────────────────

model Question {
  id            String             @id @default(cuid())
  formationId   String
  formation     Formation          @relation(fields: [formationId], references: [id])
  participantId String
  participant   ParticipantProfile @relation(fields: [participantId], references: [id])
  texte         String             @db.Text
  lue           Boolean            @default(false)
  createdAt     DateTime           @default(now())
}

model Ressource {
  id          String    @id @default(cuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id])
  nom         String
  fileBase64  String?   @db.Text
  url         String?
  taille      Int?
  slotId      String? // support de cours rattaché à un créneau (cursus/DU)
  createdAt   DateTime  @default(now())
}

// ─── FORMATIONS ───────────────────────────────────────────────────────────────

model Formation {
  id          String           @id @default(cuid())
  slug        String           @unique
  formateurId String
  formateur   FormateurProfile @relation(fields: [formateurId], references: [id])

  // Infos générales
  titre         String
  specialite    String
  niveau        String // debutant | intermediaire | expert
  description   String @db.Text
  objectifs     Json // string[]
  programme     Json // { heure, titre, description, type }[]
  bibliographie Json?

  // Logistique
  date            DateTime
  heureDebut      String // "08:30"
  heureFin        String // "17:30"
  dureeHeures     Int
  placesTotal     Int
  placesRestantes Int

  // Lieu (rempli après confirmation salle par l'admin)
  lieuNom      String?
  lieuAdresse  String?
  lieuVille    String?
  lieuSalle    String?
  lieuFeatures Json? // string[]

  // Tarif
  prixHT         Decimal @db.Decimal(10, 2)
  exonerationTVA Boolean @default(true) // art. 261-4-4° CGI

  statut StatutFormation @default(BROUILLON)

  // Déclaration de conflits d'intérêts
  conflitsInterets String? @db.Text
  declarationCoi   Boolean @default(false)

  // Infos pratiques (éditables par le formateur)
  publicCible      String? // ex: "Tous professionnels de santé", "Médecins spécialistes"
  restauration     String? // ex: "Pause café + déjeuner inclus"
  formatFormation  String? // "masterclass" | "atelier" | "conference" | "symposium"
  minParticipants  Int?    @default(8)
  equipements      Json?   // string[]

  // Documents
  programmeDocUrl String?
  supportCoursUrl String?

  // Les 3 premières formations du formateur sont gratuites (pas d'abonnement requis)
  gratuite Boolean @default(false)

  // Cycle de vie de la session live
  sessionStatus    String?   // "IDLE" | "EN_COURS" | "EN_PAUSE" | "TERMINEE"
  sessionStartedAt DateTime?
  sessionEndedAt   DateTime?
  sessionLog       Json?    // array of { type: string, time: string }
  pvSigne          Boolean  @default(false)
  pvSigneAt        DateTime?
  bilanSigne       Boolean  @default(false)
  bilanSigneAt     DateTime?
  certificatSigne  Boolean  @default(false)
  certificatSigneAt DateTime?
  emargementSigne  Boolean  @default(false)
  emargementSigneAt DateTime?
  signatureFormateurSnap String? @db.Text  // snapshot de la signature au moment de la signature
  pvContent              Json?            // { objectifsAtteints, observations, acquis }
  bilanContent           Json?            // { resume, recommandations, pointsForts }
  afficheParams          Json?            // { titre, description, infoPratiques, couleur }

  // Classe virtuelle
  modaliteSession      String?   // "PRESENTIEL" | "VIRTUEL" | "MIXTE"
  sessionCurrentPage   Int?      @default(1)
  sessionSlidesBase64  String?   @db.Text // PDF base64, max ~15MB
  sessionDrawingData   String?   @db.Text // JSON: { page, strokes }

  // Certification périodique (rattachement optionnel à une action validante)
  certifBlocCode    String? // "COGNITIF" | "QUALITE" | "RELATION" | "SANTE"
  certifActionTitre String?

  // Journée d'un cursus coordonné (DU) — null pour une formation classique
  cursusId String?
  cursus   Cursus? @relation(fields: [cursusId], references: [id])
  visioUrl String? // lien visio externe (Zoom/Teams) pour les journées en distanciel

  inscriptions  Inscription[]
  demandeSalle  DemandeSalle?
  paiements     Paiement[]
  virements     Virement[]
  emargements   Emargement[]
  satisfactions SatisfactionReponse[]
  questions     Question[]
  ressources    Ressource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── DEMANDES DE SALLE ────────────────────────────────────────────────────────

model DemandeSalle {
  id          String    @id @default(cuid())
  formationId String    @unique
  formation   Formation @relation(fields: [formationId], references: [id])

  statut StatutDemandeSalle @default(EN_ATTENTE)

  // Contact hôtel
  hotelNom    String?
  hotelEmail  String?
  hotelPhone  String?
  emailEnvoye Boolean   @default(false)
  dateContact DateTime?

  // Devis
  devisHT      Decimal?  @db.Decimal(10, 2)
  fraisGestion Decimal?  @db.Decimal(10, 2) // 10% du devis HT
  totalHT      Decimal?  @db.Decimal(10, 2)
  devisUrl     String?
  dateDevis    DateTime?

  // Validation et transmission au formateur
  dateValidation   DateTime?
  dateTransmission DateTime?

  paiement Paiement?
  notes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── INSCRIPTIONS ─────────────────────────────────────────────────────────────

model Inscription {
  id            String             @id @default(cuid())
  participantId String
  participant   ParticipantProfile @relation(fields: [participantId], references: [id])
  formationId   String
  formation     Formation          @relation(fields: [formationId], references: [id])

  statut StatutInscription @default(EN_ATTENTE_PAIEMENT)

  // Montants calculés à l'inscription
  montantHT    Decimal @db.Decimal(10, 2)
  commission   Decimal @db.Decimal(10, 2) // 20% plateforme
  netFormateur Decimal @db.Decimal(10, 2) // 80% au formateur

  // Stripe
  stripePaymentIntentId String? @unique
  stripeSessionId       String? @unique

  // Documents
  convocationSignee    Boolean   @default(false)
  convocationSigneeAt  DateTime?                  // horodatage signature formateur
  convocationAccuseAt  DateTime?                  // accusé de réception participant
  conventionSignee     Boolean   @default(false)
  conventionSigneeAt   DateTime?                  // horodatage signature formateur
  conventionParticipantSigneeAt DateTime?          // horodatage signature participant
  conventionSeal       String?                    // HMAC une fois les deux signatures
  conventionUrl    String?
  attestationUrl   String?

  // Évaluation post-formation
  noteSatisfaction Int? // 1-5
  commentaire      String? @db.Text

  paiement      Paiement?
  remboursement Remboursement?
  emargements   Emargement[]
  satisfaction  SatisfactionReponse?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, formationId])
}

// ─── PAIEMENTS ────────────────────────────────────────────────────────────────

model Paiement {
  id     String         @id @default(cuid())
  type   TypePaiement
  statut StatutPaiement @default(EN_ATTENTE)

  montantHT  Decimal  @db.Decimal(10, 2)
  stripeFees Decimal? @db.Decimal(10, 2)

  stripeId String? @unique // PaymentIntent ID ou Invoice ID Stripe

  // Un seul lien sera non-null selon le type
  inscriptionId  String?       @unique
  inscription    Inscription?  @relation(fields: [inscriptionId], references: [id])
  demandeSalleId String?       @unique
  demandeSalle   DemandeSalle? @relation(fields: [demandeSalleId], references: [id])
  formationId    String?
  formation      Formation?    @relation(fields: [formationId], references: [id])

  // Facture générée
  numeroFacture String? @unique
  factureUrl    String?

  datePaiement DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── VIREMENTS FORMATEURS (J+7 après formation) ───────────────────────────────

model Virement {
  id          String           @id @default(cuid())
  formateurId String
  formateur   FormateurProfile @relation(fields: [formateurId], references: [id])
  formationId String
  formation   Formation        @relation(fields: [formationId], references: [id])

  montantNet Decimal        @db.Decimal(10, 2)
  statut     StatutVirement @default(EN_ATTENTE)

  stripeTransferId String? @unique
  ibanDestinataire String?

  dateVirement DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── REMBOURSEMENTS ───────────────────────────────────────────────────────────

model Remboursement {
  id            String      @id @default(cuid())
  inscriptionId String      @unique
  inscription   Inscription @relation(fields: [inscriptionId], references: [id])

  motif       String
  statut      StatutRemboursement @default(EN_ATTENTE)
  montant     Decimal             @db.Decimal(10, 2)
  eligible    Boolean // J-14 ou formation annulée
  raisonRefus String?

  stripeRefundId String? @unique

  dateDemande    DateTime  @default(now())
  dateTraitement DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── PARAMÈTRES ORGANISME ─────────────────────────────────────────────────────

model CompanySettings {
  id                String  @id @default("singleton")
  raisonSociale     String  @default("Masterclass Medical")
  siret             String?
  numeroDeclaration String? // N° déclaration d'activité formation professionnelle
  adresse           String?
  codePostal        String?
  ville             String?
  phone             String?
  email             String?
  representantLegal String?
  siteWeb           String?

  updatedAt DateTime @updatedAt
}

// ─── SATISFACTION ─────────────────────────────────────────────────────────────

model SatisfactionReponse {
  id            String      @id @default(cuid())
  inscriptionId String      @unique
  inscription   Inscription @relation(fields: [inscriptionId], references: [id])
  formationId   String
  formation     Formation   @relation(fields: [formationId], references: [id])

  noteContenu      Int?
  noteFormateur    Int?
  noteOrganisation Int?
  noteSupport      Int?
  noteGlobal       Int?

  objectifsAtteints  Boolean?
  recommanderait     Boolean?
  pointsForts        String?  @db.Text
  pointsAmelioration String?  @db.Text
  commentaireLibre   String?  @db.Text

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── ÉMARGEMENT ───────────────────────────────────────────────────────────────

model Emargement {
  id            String      @id @default(cuid())
  formationId   String
  formation     Formation   @relation(fields: [formationId], references: [id])
  inscriptionId String
  inscription   Inscription @relation(fields: [inscriptionId], references: [id])

  token       String   @unique @default(cuid()) // lien unique envoyé par email le jour J
  tokenExpire DateTime

  presentMatin       Boolean   @default(false)
  presentApresMidi   Boolean   @default(false)
  signatureMatin     DateTime?
  signatureApresMidi DateTime?

  pvParticipantSignedAt       DateTime?
  pvParticipantSignatureBase64 String?  @db.Text
  correctionPresence          Boolean?
  correctionJustification     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formationId, inscriptionId])
}

// ─── CERTIFICATION PÉRIODIQUE ─────────────────────────────────────────────────

model CertificationBloc {
  code  String @id // "COGNITIF" | "QUALITE" | "RELATION" | "SANTE"
  ordre Int
  titre String
  description String @db.Text
  emoji   String
  couleur String
  actionsRequises Int  @default(2)
  exemples        Json // string[] — exemples d'actions (base commune)
  justificatifs   Json // string[] — types de justificatifs attendus

  actions CertificationActionRef[]
}

model CertificationActionRef {
  id         String  @id @default(cuid())
  blocCode   String
  bloc       CertificationBloc @relation(fields: [blocCode], references: [code], onDelete: Cascade)
  specialite String? // null = base commune, sinon déclinaison spécifique à la spécialité
  titre      String
  description      String? @db.Text
  typeJustificatif String?

  @@index([blocCode, specialite])
}

model CertificationCompte {
  id         String  @id @default(cuid())
  userId     String  @unique
  specialite String?
  anneeDES   Int? // année de validation du DES / d'entrée en exercice

  justificatifs CertificationJustificatif[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CertificationJustificatif {
  id       String @id @default(cuid())
  compteId String
  compte   CertificationCompte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  blocCode     String // référence CertificationBloc.code
  actionTitre  String
  typeDocument String?
  fichierNom    String?
  fichierBase64 String? @db.Text
  url           String? // lien direct (ex: attestation PDF plateforme)
  source      String    @default("UPLOAD") // "UPLOAD" | "PLATEFORME"
  formationId String? // si généré automatiquement depuis une formation plateforme
  dateAction  DateTime?

  createdAt DateTime @default(now())

  @@unique([compteId, formationId])
  @@index([compteId, blocCode])
}

// ─── COORDINATION D'ENSEIGNEMENT (DU / cursus multi-journées) ─────────────────

model Cursus {
  id     String @id @default(cuid())
  slug   String @unique
  titre  String
  description String  @db.Text
  specialite  String
  annee       String? // ex : "2026-2027"
  publique    Boolean @default(false)
  statut      String  @default("BROUILLON") // BROUILLON | PUBLIE | ARCHIVE
  inscriptionMode String   @default("IMPORT") // IMPORT | PAYANT
  prixHT          Decimal? @db.Decimal(10, 2)

  // Lieu par défaut (pré-rempli sur les journées présentiel)
  lieuNom     String?
  lieuAdresse String?
  lieuVille   String?

  // Certification périodique
  certifBlocCode    String?
  certifActionTitre String?

  // Modalité d'émargement (impacte qui peut lancer l'émargement et la validité du QR)
  emargementMode String @default("DEMI_JOURNEE") // PAR_COURS | DEMI_JOURNEE | JOUR

  // Marque blanche : nom + logo de l'organisation qui délivre l'enseignement
  orgNom         String?
  orgLogoBase64  String? @db.Text // data URI complet (data:image/png;base64,...) ou base64 brut
  masquerMM      Boolean @default(false) // supprime toute mention Masterclass Médical

  // Comité d'organisation et contact (affichés sur le programme et les documents)
  organisateursTexte String? @db.Text // noms libres, un par ligne, en plus des enseignants cochés "organisateur"
  contactNom         String? // ex : "Secrétariat pédagogique du DU"
  contactEmail       String?
  contactTelephone   String?

  // Tableau de bord multi-DU : capacité indicative pour le taux de remplissage
  capaciteMax Int?

  // Volume horaire attendu (en heures, ex : 42.5) — comparé au volume horaire réel des créneaux
  volumeHoraireAttendu Float?

  templateOrigineId String? // template utilisé à la création (traçabilité, optionnel)

  // Affichés sur la page publique du DU
  prerequis  String? @db.Text // ex : diplômes, expérience requise pour candidater
  publicVise String? @db.Text // ex : médecins généralistes, internes en 3e cycle...

  coordinateurId String
  coordinateur   FormateurProfile @relation("CursusCoordonnes", fields: [coordinateurId], references: [id])

  enseignants CursusEnseignant[]
  journees    Formation[]
  messages    CursusMessage[]
  echanges    CursusEchange[]
  prospects   CursusProspect[]
  validationModules CursusValidationModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CursusEnseignant {
  id       String @id @default(cuid())
  cursusId String
  cursus   Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)

  email       String
  nom         String?
  phone       String?
  fonction    String? // ex : "PU-PH", "MCU-PH", "Praticien hospitalier"
  formateurId String? // rattaché quand le compte formateur existe / a accepté
  statut      String  @default("EN_ATTENTE") // EN_ATTENTE | ACCEPTE
  inviteToken String  @unique @default(cuid())
  coCoordinateur Boolean @default(false)
  role            String  @default("ENSEIGNANT") // ENSEIGNANT | SECRETAIRE
  estOrganisateur Boolean @default(false) // affiché dans le comité d'organisation du programme

  createdAt DateTime @default(now())

  @@unique([cursusId, email])
}

model CursusMessage {
  id       String @id @default(cuid())
  cursusId String
  cursus   Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)

  auteurEmail String
  auteurNom   String
  texte       String @db.Text

  createdAt DateTime @default(now())
}

model CursusEchange {
  id       String @id @default(cuid())
  cursusId String
  cursus   Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)

  deEnseignantId   String // CursusEnseignant.id du proposant
  versEnseignantId String
  journeeAId       String // Formation.id
  slotIdA          String
  journeeBId       String
  slotIdB          String
  statut   String    @default("EN_ATTENTE") // EN_ATTENTE | ACCEPTE | REFUSE
  decideAt DateTime?

  createdAt DateTime @default(now())
}

model CursusRappel {
  id          String   @id @default(cuid())
  formationId String
  email       String
  type        String // J15 | J7 | H48 | MATIN
  sentAt      DateTime @default(now())

  @@unique([formationId, email, type])
}

model CursusProspect {
  id       String @id @default(cuid())
  cursusId String
  cursus   Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)

  email    String
  nom      String?
  prenom   String?
  phone    String?
  fonction String? // texte libre détecté ou saisi (ex : "Interne DES cardio", "PU-PH")
  statut   String  @default("ATTENTE") // ATTENTE | ACCEPTE | REFUSE

  // Dossier d'inscription (DU sélectifs) : { cv?: {nom,base64}, lettre?: {...}, diplome?: {...} }
  piecesJointes Json?

  createdAt DateTime @default(now())

  @@unique([cursusId, email])
}

// ─── VALIDATION DU DU (examens, mémoire, stages…) ─────────────────────────────

model CursusValidationModule {
  id       String @id @default(cuid())
  cursusId String
  cursus   Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)

  type       String   // ECRIT | ORAL | MEMOIRE | SOUTENANCE | STAGE | ASSIDUITE | AUTRE
  intitule   String
  dateEpreuve DateTime?
  infos       String? @db.Text
  coefficient Float @default(1)
  noteMax     Int   @default(20)
  seuilValidation Float? // note minimale pour valider ce module
  cloture    Boolean @default(false)
  clotureAt  DateTime?
  clotureExportUrl String? // URL du PDF exporté à la clôture (à garder pour audit)

  notes CursusNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CursusNote {
  id       String @id @default(cuid())
  moduleId String
  module   CursusValidationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  participantId String
  note        Float?
  commentaire String? @db.Text

  saisiParUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, participantId])
}

// Journal d'audit pour la sécurité des notes (anti-effacement, versioning simple)
model CursusNoteHistorique {
  id      String   @id @default(cuid())
  moduleId String
  participantId String
  noteAvant       Float?
  noteApres       Float?
  commentaireAvant String? @db.Text
  commentaireApres String? @db.Text
  parUserId String?
  createdAt DateTime @default(now())

  @@index([moduleId, participantId])
}

// ─── MODÈLE DE DU RÉUTILISABLE ─────────────────────────────────────────────────

model CursusTemplate {
  id          String @id @default(cuid())
  formateurId String
  nom         String
  specialite  String?
  description String? @db.Text

  // Réglages recopiés à la création d'un nouveau cursus
  emargementMode     String  @default("DEMI_JOURNEE")
  organisateursTexte String? @db.Text
  contactNom         String?
  contactEmail       String?
  contactTelephone   String?
  certifBlocCode     String?
  certifActionTitre  String?

  // Structure des modules de validation à recréer (sans dates ni notes)
  // [{ type, intitule, coefficient, noteMax, seuilValidation }]
  modulesValidation Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
